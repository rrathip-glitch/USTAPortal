# USTA credentials
USTA_USERNAME= bhavana.279@gmail.com 
USTA_PASSWORD= 4Tennis$

# The USTA player ID for the dashboard's primary user.
# Captured during recon — likely a GUID embedded in the user's profile URL.
USTA_USER_PLAYER_ID= 

# Storage. On Railway, mount a persistent volume at /data and keep these paths.
DATABASE_URL=sqlite:////data/usta.db
RAW_CACHE_DIR=/data/raw

# Logging
LOG_LEVEL=INFO

# Politeness — single user, low volume; slow requests by default.
REQUEST_INTERVAL_SECONDS=1

# Playwright
PLAYWRIGHT_HEADLESS=true

# FastAPI / Railway
PORT=8000
ENVIRONMENT=production
