# USTA credentials
USTA_USERNAME= bhavana.279@gmail.com 
USTA_PASSWORD= 4Tennis$

# The USTA player ID for the dashboard's primary user.
# Captured during recon — likely a GUID embedded in the user's profile URL.
USTA_USER_PLAYER_ID= 

# Storage. On Railway, mount a persistent volume at /data and keep these paths.
DATABASE_URL=sqlite:////data/usta.db
RAW_CACHE_DIR=/data/raw

# Logging
LOG_LEVEL=INFO

# Politeness — single user, low volume; slow requests by default.
REQUEST_INTERVAL_SECONDS=1

# Playwright
PLAYWRIGHT_HEADLESS=true

# FastAPI / Railway
PORT=8000
ENVIRONMENT=production

# Notifications (Resend). `onboarding@resend.dev` is Resend's sandbox FROM
# address and only delivers to the Resend account owner's verified email —
# for production, verify a custom domain in the Resend dashboard and replace
# NOTIFY_FROM with a sender on that domain.
RESEND_API_KEY=re_xxx_your_key_here
NOTIFY_FROM=onboarding@resend.dev
NOTIFY_TO=your-email@example.com
